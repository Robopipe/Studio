DATABASE_URL=postgres://postgres:postgres@localhost:5432/robopipe
GCP_PROJECT=io-robopipe-dev
SECRETS_PREFIX=staging_be_

# --- ML training backend ---
# Local dev: set ML_HOST to the FastAPI service to POST training requests to it.
# Cloud deploys: set ML_BATCH_IMAGE (and related ML_BATCH_* vars) to dispatch
# training as Cloud Batch jobs.
# ML_HOST=http://ml:8000

# ML_REGION=europe-west4
# ML_BATCH_IMAGE=europe-west4-docker.pkg.dev/io-robopipe-dev/robopipe-staging/ml:latest
# ML_BATCH_SERVICE_ACCOUNT=robopipe-staging-ml@io-robopipe-dev.iam.gserviceaccount.com
# ML_BATCH_MACHINE_TYPE=a2-ultragpu-1g   # 12 vCPU, 170 GB RAM, 1× A100 80 GB (bundled)
# # Leave GPU_TYPE/COUNT empty for A2/A3/G2 (GPU bundled with machine type).
# # Only set them for N1-style custom attachment.
# ML_BATCH_GPU_TYPE=
# ML_BATCH_GPU_COUNT=0
# ML_BATCH_BOOT_DISK_GB=100
# ML_BATCH_MAX_RUN_SECONDS=86400
# ML_BATCH_TASK_CPU_MILLI=11000    # 11 vCPU out of 12 on a2-ultragpu-1g
# ML_BATCH_TASK_MEMORY_MIB=163840  # 160 GiB out of 170 on a2-ultragpu-1g
# ML_BATCH_API_KEY_SECRET=mlSecret
# ML_BATCH_HUBAI_API_KEY_SECRET=hubaiApiKey
# ML_BATCH_NETWORK=
# ML_BATCH_SUBNETWORK=
