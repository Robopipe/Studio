DATABASE_URL=postgres://postgres:postgres@localhost:5432/robopipe
GCP_PROJECT=io-robopipe-dev
SECRETS_PREFIX=staging_be_

# --- ML training backend (ml-yolo) ---
# Local dev: set ML_HOST_YOLO to the FastAPI service to POST training requests to it.
# Cloud deploys: set ML_BATCH_IMAGE_YOLO (and related ML_BATCH_* vars) to dispatch
# training as Cloud Batch jobs.
# ML_HOST_YOLO=http://ml-yolo:8000

# ML_REGION controls where Cloud Batch runs training jobs; ML_BATCH_IMAGE_YOLO's
# region prefix is the Artifact Registry location (typically the infra
# region, not ML_REGION — they can legitimately differ).
# ML_REGION=us-central1
# ML_BATCH_IMAGE_YOLO=europe-west4-docker.pkg.dev/io-robopipe-dev/robopipe-staging/ml-yolo:latest
# ML_BATCH_SERVICE_ACCOUNT=robopipe-staging-ml@io-robopipe-dev.iam.gserviceaccount.com
# ML_BATCH_MACHINE_TYPE=a2-ultragpu-1g   # 12 vCPU, 170 GB RAM, 1× A100 80 GB (bundled)
# # Leave GPU_TYPE/COUNT empty for A2/A3/G2 (GPU bundled with machine type).
# # Only set them for N1-style custom attachment.
# ML_BATCH_GPU_TYPE=
# ML_BATCH_GPU_COUNT=0
# # Custom boot-disk image. Leave empty to use Batch's default Container-Optimized
# # OS (driver downloaded at boot, ~2-3 min). Point at a Deep Learning VM image
# # (driver + Docker + NVIDIA Container Toolkit pre-baked) to skip that download;
# # the API then disables installGpuDrivers and runs the container with `--gpus all`.
# ML_BATCH_BOOT_DISK_IMAGE=projects/ml-images/global/images/family/common-cu129-ubuntu-2204-nvidia-580
# ML_BATCH_BOOT_DISK_GB=100
# ML_BATCH_MAX_RUN_SECONDS=86400
# ML_BATCH_TASK_CPU_MILLI=11000    # 11 vCPU out of 12 on a2-ultragpu-1g
# ML_BATCH_TASK_MEMORY_MIB=163840  # 160 GiB out of 170 on a2-ultragpu-1g
# ML_BATCH_SHM_SIZE=16g            # Docker --shm-size for /dev/shm inside container
# ML_BATCH_API_KEY_SECRET=mlSecret
# ML_BATCH_HUBAI_API_KEY_SECRET=hubaiApiKey
# ML_BATCH_NETWORK=
# ML_BATCH_SUBNETWORK=

# --- Gemini (Vertex AI) — AI hyperparameter suggestions ---
# Auth is Application Default Credentials — no API key. Locally:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project io-robopipe-dev
# Your account needs roles/aiplatform.user on the project and the
# aiplatform.googleapis.com API enabled. The feature is enabled by GCP_PROJECT
# being set; the endpoint returns 503 without it.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_LOCATION=europe-west4
