HOST=0.0.0.0
PORT=8001

# Webhook endpoint on the API. Leave blank to skip progress/complete callbacks.
# When running via docker-compose, the API service is reachable at http://api:3000.
WEBHOOK_URL=http://api:3000/models

# Shared secret — must match the API's configured ML webhook secret.
API_KEY=local-dev-secret

# HubAI key, required for RVC2/3/4 conversion. Set a dummy value for RAW-only
# local testing, since the conversion path won't be invoked without those outputs.
HUBAI_API_KEY=dummy

# Cloud Batch entrypoint only — pre-signed URL pointing at the ModelConfig JSON.
# Leave unset for HTTP / local-dev mode.
# CONFIG_URL=
