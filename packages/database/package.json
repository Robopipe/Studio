{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build --watch",
    "build": "pnpm build:cjs && pnpm build:esm",
    "build:cjs": "tsc -b tsconfig.cjs.json",
    "build:esm": "tsc -b tsconfig.esm.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./schema": {
      "types": "./dist/cjs/schema/index.d.ts",
      "import": "./dist/esm/schema/index.js",
      "require": "./dist/cjs/schema/index.js"
    },
    "./schema/*": {
      "types": "./dist/cjs/schema/*.d.ts",
      "import": "./dist/esm/schema/*.js",
      "require": "./dist/cjs/schema/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "./dist/cjs/schema/index.d.ts"
      ],
      "schema/*": [
        "./dist/cjs/schema/*.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@repo/schema": "workspace:*",
    "drizzle-orm": "1.0.0-beta.12-a5629fb"
  }
}
