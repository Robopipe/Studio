FROM node:22-alpine AS pruner

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
RUN npm install -g turbo

WORKDIR /app

COPY . .

RUN turbo prune api --docker

FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app

COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=api

FROM node:22-alpine AS production

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app

COPY --from=build /app/node_modules node_modules
COPY --from=build /app/apps/api/node_modules apps/api/node_modules
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/apps/api/drizzle.config.ts apps/api/drizzle.config.ts
COPY --from=build /app/apps/api/src/core/database/schema apps/api/src/core/database/schema
COPY --from=build /app/packages/database packages/database
COPY --from=build /app/packages/schema packages/schema
COPY --from=build /app/package.json package.json

EXPOSE 3000

CMD ["sh", "-c", "cd apps/api && pnpm drizzle-kit push --config ./drizzle.config.ts && cd /app && node apps/api/dist/main"]
